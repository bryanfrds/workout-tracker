# Public half of the web-push key pair (safe to share).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private half (generate both with: npx web-push generate-vapid-keys).
VAPID_PRIVATE_KEY=
# Upstash QStash: console.upstash.com > QStash > Environment Keys.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional: public URL QStash calls back to (defaults to the request's own URL).
APP_URL=
# Google sign-in: console.cloud.google.com > Google Auth Platform > Clients.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Generate with: openssl rand -base64 33
AUTH_SECRET=

# Neon Postgres (pooled): console.neon.tech > your project > Connection string.
DATABASE_URL=
